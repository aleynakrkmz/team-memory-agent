# Copy to .env and fill in. Never commit .env.
OLLAMA_HOST=http://localhost:11434
# Extraction and the agent loop. Team default after model selection: qwen3:8b.
# A blank value is an error. Leave the line out to use config/agent.json.
AGENT_MODEL=qwen3:8b
# Thinking mode for JSON calls. Default false (config/agent.json). qwen3 will
# otherwise spend the call on hidden reasoning and look frozen.
# OLLAMA_THINK=false
# Per-call HTTP timeout in seconds. Default 120. The agent also caps a call
# at the time left in its wall-clock budget.
# OLLAMA_TIMEOUT_S=120
# Maximum tokens generated for one JSON call. Default 4096.
# OLLAMA_NUM_PREDICT=4096
DATAGEN_MODEL_A=
DATAGEN_MODEL_B=
